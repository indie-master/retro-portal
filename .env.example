PORT=8088
BIND_ADDR=127.0.0.1

# UID/GID used by the backend when it writes ROM, BIOS, covers, stats and catalog files.
PUID=1000
PGID=1000

# Leave empty to generate a persistent random token in catalog/admin-token on first start.
# Or set your own value (recommended minimum: 32 random characters).
ADMIN_TOKEN=

# Optional. Enables title/year/overview/box-art lookup from TheGamesDB.
# Proposed metadata is NOT published automatically: it waits for approval in /admin.html.
THEGAMESDB_API_KEY=

# Wikipedia is used only to propose a short history paragraph. Fixed public API hosts are used.
# 1 = enabled, 0 = disabled.
WIKIPEDIA_METADATA=1

# ZIP ROM upload is disabled by default because archive formats increase attack surface.
# The server never extracts uploads, but enabling ZIP should still be an explicit decision.
ALLOW_ZIP_ROMS=0

# Maximum ROM/BIOS upload size in bytes. Default: 2 GiB.
MAX_UPLOAD_BYTES=2147483648
