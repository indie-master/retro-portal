PORT=8088
BIND_ADDR=127.0.0.1

# UID/GID used by the backend when it writes ROM, BIOS, covers and catalog files.
PUID=1000
PGID=1000

# Required for /admin.html. Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me-before-production

# Optional. Enables one-click metadata/box-art enrichment from TheGamesDB.
THEGAMESDB_API_KEY=

# Maximum ROM/BIOS upload size in bytes. Default: 2 GiB.
MAX_UPLOAD_BYTES=2147483648
