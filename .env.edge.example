# Public bind for this edge node. Keep localhost when a host reverse proxy/CDN is in front.
EDGE_BIND_ADDR=127.0.0.1
EDGE_PORT=8088

# Small dynamic API/WebSocket traffic is proxied to the control/origin node.
# Use HTTPS for traffic that crosses an untrusted network.
CONTROL_ORIGIN_SCHEME=https
CONTROL_ORIGIN_HOST=origin.arcade.example.com
CONTROL_ORIGIN_PORT=443

# Per-edge resource guardrails. Adjust for the host capacity.
EDGE_MEMORY_LIMIT=384m
EDGE_CPU_LIMIT=1.0
